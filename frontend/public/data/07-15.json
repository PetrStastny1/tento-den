ká knížata, tedy mezi nejvýznamnější šlechtice Svaté říše římské. Hoch patrně trpěl duševní nemocí.","sensitive":false,"stateDay":null,"anniversary":null,"source":{"title":"15. červenec","revisionUrl":"https://cs.wikipedia.org/w/index.php?title=15._%C4%8Dervenec&oldid=25424988","historyUrl":"https://cs.wikipedia.org/w/index.php?title=15._%C4%8Dervenec&action=history","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.cs","fetchedAt":"2026-10-29T02:49:10+00:00"},"article":{"title":"Jiří z Poděbrad","url":"https://cs.wikipedia.org/w/index.php?title=Ji%C5%99%C3%AD_z_Pod%C4%9Bbrad&oldid=26276099"}}]}
