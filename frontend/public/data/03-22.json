.","url":"https://cs.wikipedia.org/w/index.php?title=Leont%C3%BDna&oldid=25831882","source":{"title":"Leontýna","wiki":"cs.wikipedia.org","revisionUrl":"https://cs.wikipedia.org/w/index.php?title=Leont%C3%BDna&oldid=25831882","historyUrl":"https://cs.wikipedia.org/w/index.php?title=Leont%C3%BDna&action=history","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.cs","fetchedAt":"2026-10-29T14:59:09+00:00"}},"bearer":null}],"otherNames":[{"name":"Lia","note":null},{"name":"Oktavián","note":"podle starého kalendáře"},{"name":"Oktavius","note":"podle starého kalendáře"}],"source":{"title":"22. březen","wiki":"cs.wikipedia.org","revisionUrl":"https://cs.wikipedia.org/w/index.php?title=22._b%C5%99ezen&oldid=25995045","historyUrl":"https://cs.wikipedia.org/w/index.php?title=22._b%C5%99ezen&action=history","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.cs","fetchedAt":"2026-10-29T02:45:44+00:00"}},"sk":{"country":"sk","label":"Slovensko","language":"sk","heading":"Meniny má","names":[{"name":"Beňadik","note":null,"variantOf":null,"meaning":{"title":"Beňadik","aboutName":"Beňadik","extract":"Beňadik je mužské krstné meno. Je to slovenská podoba latinského mena Benedikt, ktoré vzniklo zo slova benedictus „požehnaný, blahoslavený“. Meniny na Slovensku má 22. marca.","url":"https://sk.wikipedia.org/w/index.php?title=Be%C5%88adik&oldid=7930780","source":{"title":"Beňadik","wiki":"sk.wikipedia.org","revisionUrl":"https://sk.wikipedia.org/w/index.php?title=Be%C5%88adik&oldid=7930780","historyUrl":"https://sk.wikipedia.org/w/index.php?title=Be%C5%88adik&action=history","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.cs","fetchedAt":"2026-10-29T14:33:40+00:00"}},"bearer":null},{"name":"Benedikt","note":null,"variantOf":null,"meaning":{"title":"Benedikt (prvé meno)","aboutName":"Benedikt","extract":"Benedikt je krstné meno. Vzniklo z latinského benedictus „bl