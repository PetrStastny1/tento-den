edAt":"2026-10-28T23:22:56+00:00"},"article":{"title":"Egypt","url":"https://cs.wikipedia.org/w/index.php?title=Egypt&oldid=26251584"}},{"id":5641,"date":"07-18","year":1925,"yearLabel":"1925","section":"world","text":"Adolf Hitler publikoval svůj osobní manifest Mein Kampf. Rukopis diktoval budoucí vůdce ve vězení v Landsbergu, ve kterém si odpykával trest za pokus svrhnout říšskou vládu. Zpočátku na budoucí knize spolupracoval s Emilem Mauricem, později ho vystřídal Rudolf Hess. Kniha vyšla v desetitisícovém nákladu a stála 12 marek.","sensitive":false,"stateDay":null,"source":{"title":"18. červenec","revisionUrl":"https://cs.wikipedia.org/w/index.php?title=18._%C4%8Dervenec&oldid=26330997","historyUrl":"https://cs.wikipedia.org/w/index.php?title=18._%C4%8Dervenec&action=history","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.cs","fetchedAt":"2026-10-28T23:22:56+00:00"},"article":{"title":"Adolf Hitler","url":"https://cs.wikipedia.org/w/index.php?title=Adolf_Hitler&oldid=26070142"}},{"id":5631,"date":"07-18","year":1891,"yearLabel":"1891","section":"cz","text":"V Praze byl zahájen provoz první elektrické tramvaje na území Česka – tzv. Křižíkovy Elektrické dráhy na Letné v Praze. Vede od populární Letenské restaurace a její trasa vede ke vratům Královské obory (dnes Stromovka) a měří 766 metrů.","sensitive":false,"stateDay":null,"source":{"title":"18. červenec","revisionUrl":"https://cs.wikipedia.org/w/index.php?title=18._%C4%8Dervenec&oldid=26330997","historyUrl":"https://cs.wikipedia.org/w/index.php?title=18._%C4%8Dervenec&action=history","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.cs","fetchedAt":"2026-10-28T23:22:56+00:00"},"article":{"title":"Elektrická tramvaj","url":"https://cs.wikipedia.org/w/index.php?title=Elektrick%C3%A1_tramvaj&oldid=23841895"}},{"id":5630,"date":"07-18","year":1881,"yearLabel":"1881","section":"cz","text":"V Brně se začalo stavět divadlo na Hradbách (dnes Mahenovo divadlo Národního divadla) podle architektonického návrhu vídeňské kanceláře velmi mladých architektů Ferdinanda Fellnera ml. a Hermanna Helmera, kteří se specializovali na projektování divadelních budov. Včetně projekčních prací trvala stavba pouhých 18 měsíců a 31. října 1882 se konalo slavnostní uložení závěrečného kamene.","sensitive":false,"stateDay":null,"source":{"title":"18. červenec","revisionUrl":"https://cs.wikipedia.org/w/index.php?title=18._%C4%8Dervenec&oldid=26330997","historyUrl":"https://cs.wikipedia.org/w/index.php?title=18._%C4%8Dervenec&action=history","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.cs","fetchedAt":"2026-10-28T23:22:56+00:00"},"article":{"title":"Mahenovo divadlo","url":"https://cs.wikipedia.org/w/index.php?title=Mahenovo_divadlo&oldid=26260845"}},{"id":5629,"date":"07-18","year":1410,"yearLabel":"1410","section":"cz","text":"Pražský arcibiskup Zbyněk Zajíc z Hazmburka dal Jana Husa do klatby.","sensitive":false,"stateDay":null,"source":{"title":"18. červenec","revisionUrl":"https://cs.wikipedia.org/w/index.php?title=18._%C4%8Dervenec&oldid=26330997","historyUrl":"https://cs.wikipedia.org/w/index.php?title=18._%C4%8Dervenec&action=history","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.cs","fetchedAt":"2026-10-28T23:22:56+00:00"},"article":{"title":"Zbyněk Zajíc z Hazmburka","url":"https://cs.wikipedia.org/w/index.php?title=Zbyn%C4%9Bk_Zaj%C3%ADc_z_Hazmburka&oldid=25634896"}}]}
