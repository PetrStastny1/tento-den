services:
	# validated in Bootstrap and added at runtime
	appConfig:
		type: App\Core\Config\AppConfig
		imported: true

	- App\Core\RouterFactory
	router: @App\Core\RouterFactory::create

	# infrastructure
	clock:
		type: App\Core\Clock\Clock
		create: App\Core\Clock\SystemClock
	- App\Core\Database\Transaction
	- App\Core\Database\Migrations(directory: %migrationsDir%)
	- App\Core\Database\PendingMigrationsCheck
	curlHttpClient:
		create: App\Core\Http\CurlHttpClient(
			userAgent: App\Model\Wikipedia\UserAgent::create(@appConfig)
			timeoutSeconds: %wikimedia.timeoutSeconds%
		)
		autowired: false
	httpClient:
		type: App\Core\Http\HttpClient
		create: App\Core\Http\PoliteHttpClient(inner: @curlHttpClient, requestsPerMinute: %wikimedia.requestsPerMinute%)

	# controllers
	- App\Api\Health\HealthPresenter
	- App\Api\Error\ErrorPresenter
	- App\Api\Day\DayPresenter
	- App\Api\Event\EventPresenter

	# health
	- App\Model\Health\HealthService
	- App\Model\Health\HealthRepository

	# events
	- App\Model\Events\LinkFilter
	- App\Model\Events\DayPageParser
	- App\Model\Events\DayPageRules(%dayPageRules.ignoredSubsections%, %dayPageRules.knownItemsWithoutYear%, %dayPageRules.mappedSubsections%)
	- App\Model\Events\EventMatcher
	- App\Model\Events\PrimaryArticleSelector(genericTitles: %genericArticles%)
	- App\Model\Events\EventRepository
	- App\Model\Events\ArticleRepository

	# import
	- App\Model\Wikipedia\ActionApiClient
	wikidataApi:
		create: App\Model\Wikipedia\ActionApiClient(endpoint: App\Model\Wikipedia\ActionApiClient::Wikidata)
		autowired: false
	sitelinksSource:
		type: App\Model\Import\SitelinksSource
		create: App\Model\Wikipedia\WikidataSitelinksSource(@wikidataApi)
	- App\Model\Import\SignalRefreshService
	dayPageSource:
		type: App\Model\Import\DayPageSource
		create: App\Model\Wikipedia\WikipediaDayPageSource
	articleInfoSource:
		type: App\Model\Import\ArticleInfoSource
		create: App\Model\Wikipedia\ActionApiArticleInfoSource
	- App\Model\Import\DayImportService
	- App\Model\Import\YearImportService
	- App\Model\Import\ImportStatusRepository
	- App\Model\Import\ImportLockRepository
	- App\Model\Import\ImportReportRepository

	# selection
	- App\Model\Selection\CardRepository
	- App\Model\Selection\EventScorer
	- App\Model\Selection\DaySelector
	- App\Model\Selection\DayService
	- App\Model\Selection\BoringFilter(App\Model\Selection\TextRules(%selection.boringRules%))
	- App\Model\Selection\SensitivityClassifier(App\Model\Selection\TextRules(%selection.sensitiveRules%))

	# state holidays and significant days (Act No. 245/2000 Coll.)
	- App\Model\StateDays\StateDayCalendar(%stateDays%)
	- App\Model\StateDays\StateDayArticleRepository
	- App\Model\StateDays\StateDayArticleService
	- App\Model\StateDays\StateDayCheck
	articleSummarySource:
		type: App\Model\StateDays\ArticleSummarySource
		create: App\Model\Wikipedia\RestSummarySource

	# console
	- App\Core\Console\ConsoleApplication(typed(App\Core\Console\Command))
	- App\Console\ImportDayCommand
	- App\Console\ImportYearCommand
	- App\Console\GenericCandidatesCommand
	- App\Console\EventsReviewCommand
	- App\Console\RefreshSignalsCommand
	- App\Console\ExportStaticCommand
	- App\Console\RefreshStateDaysCommand
