application:
	# errors are rendered as JSON by the API error presenter, also in development
	catchExceptions: true
	errorPresenter: Api:Error
	mapping:
		Api: App\Api\*\**Presenter

database:
	dsn: %database.dsn%
	user: %database.user%
	password: %database.password%
	options:
		# connect on the first query, not on container creation
		lazy: true

http:
	frames: DENY
	headers:
		X-Powered-By: null
		X-Content-Type-Options: nosniff
		Referrer-Policy: no-referrer
		Content-Security-Policy: "default-src 'none'; frame-ancestors 'none'"
		Cross-Origin-Resource-Policy: same-origin
	# a stateless JSON API needs no cookies
	disableNetteCookie: true

di:
	export:
		parameters: false
		tags: false

parameters:
	migrationsDir: %appDir%/../migrations/structures
	wikimedia:
		requestsPerMinute: 200
		timeoutSeconds: 10
