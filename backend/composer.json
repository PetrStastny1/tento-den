{
    "name": "tento-den/backend",
    "description": "Tento den – REST API (Nette)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.3.0",
        "nette/application": "~3.2.0",
        "nette/bootstrap": "~3.2.0",
        "nette/database": "^3.2",
        "nette/di": "^3.2",
        "nette/http": "^3.3",
        "tracy/tracy": "^2.10"
    },
    "require-dev": {
        "nette/tester": "^2.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
