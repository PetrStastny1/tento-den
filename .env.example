# Vytvořte .env příkazem make init-env (hesla vygeneruje), pak doplňte WIKIMEDIA_CONTACT.
# .env se necommituje.

# development | production (jiná hodnota = aplikace nenastartuje)
APP_ENV=development

# MariaDB – hesla jsou povinná (make up s prázdnými odmítne start); testy používají DB_NAME_test
DB_NAME=tento_den
DB_USER=tento_den
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Kontaktní e-mail do User-Agentu požadavků na Wikimedia API (povinné, viz docs/zdroje.md)
WIKIMEDIA_CONTACT=

# Porty na 127.0.0.1
HTTP_PORT=8080
DB_HOST_PORT=3307
