# Zkopírujte do .env a vyplňte prázdné hodnoty (.env se necommituje).

# development | production – cokoli jiného než "development" běží v produkčním režimu
APP_ENV=development

# MariaDB – hesla jsou povinná (make up s prázdnými odmítne start)
DB_NAME=tento_den
DB_USER=tento_den
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Porty na 127.0.0.1
HTTP_PORT=8080
DB_HOST_PORT=3307
